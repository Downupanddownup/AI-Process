{
  "_kinds": {
    "ref": {
      "meaning": "参考文献引用",
      "syntax": "{{ref:<id>}}",
      "idSource": "参考文档的目录名",
      "resolvesTo": "该文档 body.md 的绝对路径",
      "lookupOrder": [
        "flows/<builtin|custom>/<流程>/references/",
        "data/skeleton/references/",
        "data/references/"
      ]
    }
  },
  "filePath": {
    "meaning": "本次要读的输入文件路径，按动作不同指向不同文件",
    "rule": "action.input",
    "source": "VersionChain：需求路径 / 最新回复路径 / 步目三档依据"
  },
  "nextVersionFile": {
    "meaning": "下一版文档的裸文件名，如 v8.md（不带动词目录）",
    "rule": "chain.nextName",
    "source": "VersionChain.NextVersion()"
  },
  "nextVersionPath": {
    "meaning": "下一版文档的绝对路径，用于无输入文件可锚定的动作",
    "rule": "chain.nextPath",
    "source": "VersionChain.NextVersionPath()"
  },
  "resultFilePath": {
    "meaning": "执行结果文档的绝对路径",
    "rule": "chain.resultPath",
    "source": "TopicDir + VersionChain.ResultName()"
  },
  "resultTemplatePath": {
    "meaning": "结果文档的格式模板路径，供 AI 参考写法",
    "rule": "config.resultTemplate",
    "source": "TemplateDir：result_doc.md 或 steps_result_doc.md"
  },
  "scaleSummary": {
    "meaning": "主题目录的规模摘要：文件数、可读文本量、二进制文件数",
    "rule": "manifest.summary",
    "source": "ContextRebuildManifest.Build(dir).Summary"
  },
  "fileManifest": {
    "meaning": "主题目录的完整文件清单",
    "rule": "manifest.text",
    "source": "ContextRebuildManifest.Build(dir).ManifestText"
  },
  "openMdScript": {
    "meaning": "打开 Markdown 文件的脚本路径",
    "rule": "config.openMdScript",
    "source": "Environment.OpenMdScriptPath"
  },
  "notifyScript": {
    "meaning": "显示完成通知的脚本路径",
    "rule": "config.notifyScript",
    "source": "Environment.NotificationScriptPath"
  },
  "windowId": {
    "meaning": "当前窗口编号",
    "rule": "window.active",
    "source": "Environment.WindowId"
  }
}
